<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3" data-tags="">Registo de uma consulta clínica</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>https://kamylu.github.io/Plataforma_Web_SAV/<datalist><option>https://kamylu.github.io/Plataforma_Web_SAV/</option></datalist></td><td></td></tr>
<tr><td>click</td><td>xpath=//button[@id='btn-choose-vet']/div<datalist><option>xpath=//button[@id='btn-choose-vet']/div</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='SAV Clínicas'])[1]/following::div[3]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Médico Veterinário'])[1]/preceding::div[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Portal clínico e histórico dos animais'])[1]/preceding::div[1]</option><option>xpath=//button/div</option><option>css=div.profile-icon.icon-vet</option></datalist></td><td></td></tr>
<tr><td>type</td><td>id=login-user<datalist><option>id=login-user</option><option>xpath=//input[@id='login-user']</option><option>xpath=//div[@id='login-form']/div[2]/div/input</option><option>xpath=//input</option><option>css=#login-user</option></datalist></td><td>cristina</td></tr>
<tr><td>click</td><td>id=login-pass<datalist><option>id=login-pass</option><option>xpath=//input[@id='login-pass']</option><option>xpath=//div[@id='login-form']/div[3]/div/input</option><option>xpath=//div[3]/div/input</option><option>css=#login-pass</option></datalist></td><td></td></tr>
<tr><td>type</td><td>id=login-pass<datalist><option>id=login-pass</option><option>xpath=//input[@id='login-pass']</option><option>xpath=//div[@id='login-form']/div[3]/div/input</option><option>xpath=//div[3]/div/input</option><option>css=#login-pass</option></datalist></td><td>1234</td></tr>
<tr><td>click</td><td>id=btn-submit-login<datalist><option>id=btn-submit-login</option><option>xpath=//button[@id='btn-submit-login']</option><option>xpath=//div[@id='login-form']/button</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Palavra-passe'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Nome de utilizador'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='← Voltar à seleção de perfil'])[1]/preceding::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='cristina'])[1]/preceding::button[2]</option><option>xpath=//*/text()[normalize-space(.)='Iniciar Sessão']/parent::*</option><option>xpath=//div[3]/button</option><option>css=#btn-submit-login</option></datalist></td><td></td></tr>
<tr><td>click</td><td>id=btn-read-chip<datalist><option>id=btn-read-chip</option><option>xpath=//button[@id='btn-read-chip']</option><option>xpath=//div[@id='screen-dashboard']/div/section/div[2]/div/button</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Consultar Identificação Eletrónica'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='sexta-feira, 29 de maio de 2026'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Servidor SIAC indisponível'])[1]/preceding::button[2]</option><option>xpath=//*/text()[normalize-space(.)='Simular Leitor']/parent::*</option><option>xpath=//section/div[2]/div/button</option><option>css=#btn-read-chip</option></datalist></td><td></td></tr>
<tr><td>click</td><td>id=btn-validate-sav<datalist><option>id=btn-validate-sav</option><option>xpath=//button[@id='btn-validate-sav']</option><option>xpath=//div[@id='screen-dashboard']/div/section/div[2]/div/button[2]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Consultar Identificação Eletrónica'])[1]/following::button[2]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Servidor SIAC indisponível'])[1]/preceding::button[1]</option><option>xpath=//*/text()[normalize-space(.)='Validar na Rede SAV']/parent::*</option><option>xpath=//section/div[2]/div/button[2]</option><option>css=#btn-validate-sav</option></datalist></td><td></td></tr>
<tr><td>click</td><td>id=btn-init-ato<datalist><option>id=btn-init-ato</option><option>xpath=//button[@id='btn-init-ato']</option><option>xpath=//div[@id='screen-clinical-file']/div[2]/section/div/div/button</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Registar Novo Ato Clínico'])[1]/following::button[1]</option><option>xpath=//*/text()[normalize-space(.)='Novo Registo Clínico']/parent::*</option><option>xpath=//div[2]/section/div/div/button</option><option>css=#btn-init-ato</option></datalist></td><td></td></tr>
<tr><td>click</td><td>id=ato-obs<datalist><option>id=ato-obs</option><option>xpath=//textarea[@id='ato-obs']</option><option>xpath=//div[@id='dynamic-fields']/div/textarea</option><option>xpath=//div[2]/div/textarea</option><option>css=#ato-obs</option></datalist></td><td></td></tr>
<tr><td>type</td><td>id=ato-obs<datalist><option>id=ato-obs</option><option>xpath=//textarea[@id='ato-obs']</option><option>xpath=//div[@id='dynamic-fields']/div/textarea</option><option>xpath=//div[2]/div/textarea</option><option>css=#ato-obs</option></datalist></td><td>sintomas</td></tr>
<tr><td>click</td><td>id=ato-file<datalist><option>id=ato-file</option><option>xpath=//input[@id='ato-file']</option><option>xpath=//div[@id='ato-form-wrapper']/div[3]/input</option><option>xpath=//div[2]/div[3]/input</option><option>css=#ato-file</option></datalist></td><td></td></tr>
<tr><td>click</td><td>id=ato-file<datalist><option>id=ato-file</option><option>xpath=//input[@id='ato-file']</option><option>xpath=//div[@id='ato-form-wrapper']/div[3]/input</option><option>xpath=//div[2]/div[3]/input</option><option>css=#ato-file</option></datalist></td><td>C:\fakepath\User Stories (backlog).pdf</td></tr>
<tr><td>click</td><td>id=btn-save-ato<datalist><option>id=btn-save-ato</option><option>xpath=//button[@id='btn-save-ato']</option><option>xpath=//div[@id='ato-form-wrapper']/div[4]/button</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Anexar documentação (PDF, Imagem, Rx)'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Dados clínicos da consulta'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Cancelar'])[2]/preceding::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Histórico Clínico Universal'])[1]/preceding::button[2]</option><option>xpath=//*/text()[normalize-space(.)='Guardar e Sincronizar na Rede SAV']/parent::*</option><option>xpath=//div[4]/button</option><option>css=#btn-save-ato</option></datalist></td><td></td></tr>
</tbody></table>
